{
    "Version": "2012-10-17",
    "Description": "2 of 2 policy for the knowledge base IAM role obtained from role created by the console"
    "Statement": [
        {
            "Sid": "S3ListBucketStatement",
            "Effect": "Allow",
            "Action": [
                "s3:ListBucket"
            ],
            "Resource": [
                "arn:aws:s3:::chucks-workspace-storage"
            ],
            "Condition": {
                "StringEquals": {
                    "aws:ResourceAccount": [
                        "314146339647"
                    ]
                }
            }
        },
        {
            "Sid": "S3GetObjectStatement",
            "Effect": "Allow",
            "Action": [
                "s3:GetObject"
            ],
            "Resource": [
                "arn:aws:s3:::chucks-workspace-storage/*"
            ],
            "Condition": {
                "StringEquals": {
                    "aws:ResourceAccount": [
                        "314146339647"
                    ]
                }
            }
        }
    ]
}
